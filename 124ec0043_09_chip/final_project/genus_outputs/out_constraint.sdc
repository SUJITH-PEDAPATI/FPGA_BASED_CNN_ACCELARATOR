set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design cnn_top

create_clock -name "clk" -period 10.0 -waveform {0.0 5.0} [get_ports clk]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports rst_n]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports start_i]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[7]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[6]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[5]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[4]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[3]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[2]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[1]}]
set_input_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_i[0]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports load_o]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[9]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[8]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[7]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[6]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[5]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[4]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[3]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[2]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[1]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {pixel_idx_o[0]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports busy_o]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports done_o]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {prediction_o[3]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {prediction_o[2]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {prediction_o[1]}]
set_output_delay -clock [get_clocks clk] -add_delay 2.0 [get_ports {prediction_o[0]}]
set_wire_load_mode "enclosed"
set_dont_use true [get_lib_cells slow_vdd1v0/SDFFHQX1]
