
# ============================================================
# QUANTA_2 CNN Accelerator
# Target: Digilent ZedBoard - Zynq-7000
# PL clock: 100 MHz onboard oscillator
# ============================================================

# Onboard 100 MHz clock input
set_property -dict { PACKAGE_PIN Y9 IOSTANDARD LVCMOS33 } [get_ports {clk_0}]

# Clock period = 10 ns (100 MHz)
create_clock -name sys_clk -period 10.000 -waveform {0.000 5.000} [get_ports {clk_0}]
